{
  "manifest_version": 3,
  "name": "Radar 360 · por Seller.IA",
  "version": "1.14.0",
  "description": "Le um nicho da Shopee por dentro: quem vende, quanto vende, a que preco, e por quanto voce precisaria comprar para competir.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://shopee.com.br/*",
    "https://seller.shopee.com.br/*",
    "https://mkfreezlizdbfpjjpxoo.supabase.co/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shopee.com.br/*",
        "https://seller.shopee.com.br/*"
      ],
      "js": [
        "ponte.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://shopee.com.br/*",
        "https://seller.shopee.com.br/*"
      ],
      "js": [
        "mercado.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Radar 360",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
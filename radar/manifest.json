{
  "manifest_version": 3,
  "name": "Radar Shopee · mapeador",
  "version": "1.2.1",
  "description": "Escuta tudo que a Shopee carrega enquanto voce navega e monta o mapa do que existe. Nao altera nada, so observa.",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://seller.shopee.com.br/*",
    "https://shopee.com.br/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://seller.shopee.com.br/*",
        "https://shopee.com.br/*"
      ],
      "js": [
        "interceptor-injetor.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://seller.shopee.com.br/*",
        "https://shopee.com.br/*"
      ],
      "js": [
        "radar.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "interceptor.js"
      ],
      "matches": [
        "https://seller.shopee.com.br/*",
        "https://shopee.com.br/*"
      ]
    }
  ],
  "action": {
    "default_title": "Radar Shopee",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}